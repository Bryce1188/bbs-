{
  "name": "bbs-next-mysql",
  "version": "2.0.0",
  "private": true,
  "description": "现代化 BBS 社区系统：Next.js、Supabase、shadcn/ui、Motion、Vercel 双轨重构版。",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server.mjs",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "test": "npm run typecheck && npm run lint && npm run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "setup:mysql": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-mysql.ps1",
    "dev:win": "powershell -ExecutionPolicy Bypass -File scripts/dev-windows.ps1"
  },
  "dependencies": {
