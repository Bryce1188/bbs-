  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.22",
