# 默认走纯本地 MySQL 课程版。Supabase 变量留空，不要填占位值。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 仅本地演示后台 UI 使用。当前本地 MySQL 有真实管理员账号，保持 false 即可。
ADMIN_DEMO_MODE=false

# 目前代码使用固定 bucket 名称；只有你改名时才需要同步调整。
UPLOAD_BUCKET_AVATARS=avatars
UPLOAD_BUCKET_POST_IMAGES=post-images

# 纯本地 MySQL 课程版
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3307
LOCAL_DB_NAME=bbs_course
LOCAL_DB_USER=bbs_app
LOCAL_DB_PASSWORD=xzr1234567

# 仅执行 npm run db:local:init 时需要。本地独立 MySQL 默认 root 无密码。
LOCAL_DB_ADMIN_USER=root
LOCAL_DB_ADMIN_PASSWORD=
LOCAL_MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.4\bin
