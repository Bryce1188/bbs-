NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 仅本地演示后台 UI 使用。生产环境保持 false。
ADMIN_DEMO_MODE=false

# 仅服务端管理动作使用。不要暴露给浏览器。
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# 目前代码使用固定 bucket 名称；只有你改名时才需要同步调整。
UPLOAD_BUCKET_AVATARS=avatars
UPLOAD_BUCKET_POST_IMAGES=post-images

# 可选：仅用于直连维护脚本，应用运行不依赖。
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# 纯本地 MySQL 课程版
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=bbs_course
LOCAL_DB_USER=bbs_app
LOCAL_DB_PASSWORD=xzr1234567

# 仅执行 npm run db:local:init 时需要。可改成本机已有管理员账号。
LOCAL_DB_ADMIN_USER=root
LOCAL_DB_ADMIN_PASSWORD=xzr1234567
